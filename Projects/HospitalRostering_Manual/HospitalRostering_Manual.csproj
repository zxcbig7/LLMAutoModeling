<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HospitalRostering_Manual</RootNamespace>
    <AssemblyName>HospitalRostering_Manual</AssemblyName>
    <!-- 讓 source generator 產出的 .g.cs 落地到 Generated/，方便檢視生成碼 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- 架構 A（手寫）：composition root 手寫 new/Build/Solve/Dispose（不用 OptModel fluent）。
       框架資料防護上線後，Parameter/Set 積木改掛 attribute 交由 AutoSetsGenerator 生成 index 屬性 +
       DataContext 註冊碼；手寫的是 composition root 與各 Constraint 的建模邏輯，非資料層樣板。 -->

  <ItemGroup>
    <!-- Generated/ 只是 generator 落地供檢視，不可當一般原始碼編譯（否則與 in-memory 輸出撞名） -->
    <Compile Remove="Generated/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 所有 DLL 統一參考 repo 根 dlls/ -->
    <Reference Include="ILOG.Concert">
      <HintPath>..\..\dlls\ILOG.Concert.dll</HintPath>
    </Reference>
    <Reference Include="ILOG.CPLEX">
      <HintPath>..\..\dlls\ILOG.CPLEX.dll</HintPath>
    </Reference>
    <Reference Include="NLog">
      <HintPath>..\..\dlls\NLog.dll</HintPath>
    </Reference>
    <Reference Include="OptimFoundation.Core">
      <HintPath>..\..\dlls\OptimFoundation.Core.dll</HintPath>
    </Reference>
    <Reference Include="OptimFoundation.Cplex">
      <HintPath>..\..\dlls\OptimFoundation.Cplex.dll</HintPath>
    </Reference>

    <!-- AutoSetsGenerator：以 analyzer DLL 掛入，[OptSet]/[OptDim<>]/[OptParam] 在編譯期生成 class body -->
    <Analyzer Include="..\..\dlls\OptimFoundation.Generators.dll" />
  </ItemGroup>

</Project>
